<%- include('header') %>
<nav class="navbar">
  <div class="container nav-container">
    <a href="/admin/login" class="logo">Sitha Fashions - Admin</a>
  </div>
</nav>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <h1>Admin Login</h1>
      <p>Super Admin Access Only</p>
    </div>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" required placeholder="Admin email">
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required placeholder="Admin password">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Login</button>
    </form>
    <p class="auth-footer"><a href="/login">Customer Login</a></p>
  </div>
</div>
<%- include('footer') %>
