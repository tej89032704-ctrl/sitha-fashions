<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>My Wishlist</h2>
    </div>
    <div class="shop-toolbar" style="margin-top:0">
      <span class="shop-count"><%= items.length %> item<%= items.length !== 1 ? 's' : '' %></span>
      <select class="sort-select" onchange="window.location.href='/wishlist?sort='+this.value">
        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Recently Added</option>
        <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>Price: Low to High</option>
        <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>Price: High to Low</option>
        <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name: A-Z</option>
      </select>
    </div>
    <% if (items.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-heart"></i>
        <h3>Your wishlist is empty</h3>
        <p>Save items you love by tapping the heart icon.</p>
        <a href="/shop" class="btn btn-primary">Browse Dresses</a>
      </div>
    <% } else { %>
      <div class="dress-grid">
        <% items.forEach(item => { %>
          <div class="dress-card-wrap">
            <a href="/dress/<%= item.id %>" class="dress-card">
              <div class="dress-image">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.name %>">
                <% } else { %>
                  <div class="no-image"><i class="fas fa-image"></i></div>
                <% } %>
              </div>
              <div class="dress-info">
                <h3><%= item.name %></h3>
                <p class="dress-category"><%= item.category %></p>
                <p class="dress-price">₹<%= Number(item.price).toLocaleString() %></p>
              </div>
            </a>
            <button class="wishlist-btn wishlisted wishlist-btn-style" data-id="<%= item.id %>">
              <i class="fas fa-heart"></i>
            </button>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<script>
document.querySelectorAll('.wishlist-btn').forEach(btn => {
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    const dressId = this.dataset.id;
    fetch('/wishlist/toggle', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ dress_id: dressId })
    }).then(r => r.json()).then(data => {
      if (!data.wishlisted) this.closest('.dress-card-wrap').remove();
    });
  });
});
</script>
<%- include('../partials/footer') %>