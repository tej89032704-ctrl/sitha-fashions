<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <a href="/orders" class="btn btn-outline">&larr; Back to Orders</a>
    <div class="order-detail">
      <div class="order-detail-header">
        <h1>Order #<%= order.id %></h1>
        <span class="order-status status-<%= order.status %>"><%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %></span>
      </div>
      <div class="order-detail-grid">
        <div class="order-detail-items">
          <h3>Items</h3>
          <% items.forEach(item => { %>
            <div class="order-detail-item">
              <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>"><% } %>
              <div>
                <p><strong><%= item.name %></strong></p>
                <small>Qty: <%= item.quantity %> | Size: <%= item.size || '-' %> | Price: ₹<%= Number(item.price).toLocaleString() %></small>
                <% if (order.status === 'delivered') { %>
                  <form action="/returns/add" method="POST" class="return-form">
                    <input type="hidden" name="order_id" value="<%= order.id %>">
                    <input type="hidden" name="dress_id" value="<%= item.dress_id %>">
                    <input type="hidden" name="quantity" value="<%= item.quantity %>">
                    <input type="text" name="reason" placeholder="Reason for return" required>
                    <button type="submit" class="btn btn-sm btn-outline">Request Return</button>
                  </form>
                <% } %>
              </div>
              <span>₹<%= (item.price * item.quantity).toLocaleString() %></span>
            </div>
          <% }) %>
        </div>
        <div class="order-detail-summary">
          <h3>Summary</h3>
          <div class="summary-item"><span>Subtotal</span><span>₹<%= Number(order.total_amount).toLocaleString() %></span></div>
          <% if (order.discount_amount > 0) { %>
            <div class="summary-item"><span>Discount (<%= order.coupon_code %>)</span><span>-₹<%= Number(order.discount_amount).toLocaleString() %></span></div>
          <% } %>
          <div class="summary-total"><strong>Total</strong><strong>₹<%= Number(order.total_amount - order.discount_amount).toLocaleString() %></strong></div>
          <% if (order.discount_amount > 0) { %><small class="text-muted">You saved ₹<%= Number(order.discount_amount).toLocaleString() %>!</small><% } %>
        </div>
      </div>
      <div class="order-tracking">
        <h3>Tracking</h3>
        <div class="tracking-timeline">
          <% if (tracking.length === 0) { %>
            <div class="tracking-step active">
              <div class="tracking-dot"></div>
              <div><strong>Order Placed</strong><small><%= new Date(order.created_at).toLocaleString() %></small></div>
            </div>
          <% } else { %>
            <% tracking.forEach((t, i) => { %>
              <div class="tracking-step <%= i === tracking.length - 1 ? 'active' : 'done' %>">
                <div class="tracking-dot"></div>
                <div>
                  <strong><%= t.status.charAt(0).toUpperCase() + t.status.slice(1) %></strong>
                  <small><%= new Date(t.created_at).toLocaleString() %></small>
                  <% if (t.note) { %><p><%= t.note %></p><% } %>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
      <div class="order-detail-info">
        <h3>Delivery Address</h3>
        <p><%= order.address %></p>
        <p>Phone: <%= order.phone %></p>
        <p>Payment: <span class="status-<%= order.payment_status %>"><%= order.payment_status.charAt(0).toUpperCase() + order.payment_status.slice(1) %></span></p>
        <% if (order.status === 'pending') { %>
          <form action="/orders/cancel/<%= order.id %>" method="POST" onsubmit="return confirm('Cancel this order?')">
            <button type="submit" class="btn btn-danger">Cancel Order</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>