<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>My Addresses</h2>
      <button class="btn btn-primary" onclick="document.getElementById('add-form').style.display='block'">Add New</button>
    </div>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <form id="add-form" action="/addresses/add" method="POST" style="display:none" class="address-form">
      <h3>New Address</h3>
      <div class="form-row">
        <div class="form-group"><label>Label</label><input type="text" name="label" value="Home" placeholder="Home, Work, etc"></div>
        <div class="form-group"><label>Phone *</label><input type="text" name="phone" required></div>
      </div>
      <div class="form-group"><label>Address *</label><textarea name="address" required rows="2"></textarea></div>
      <div class="form-row">
        <div class="form-group"><label>City</label><input type="text" name="city"></div>
        <div class="form-group"><label>State</label><input type="text" name="state"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Pincode</label><input type="text" name="pincode"></div>
        <div class="form-group"><label><input type="checkbox" name="is_default" value="1"> Set as default</label></div>
      </div>
      <button type="submit" class="btn btn-primary">Save Address</button>
    </form>
    <div class="addresses-list">
      <% if (addresses.length === 0) { %>
        <div class="empty-state"><i class="fas fa-map-marker-alt"></i><h3>No addresses saved</h3><p>Add an address for faster checkout.</p></div>
      <% } %>
      <% addresses.forEach(a => { %>
        <div class="address-card">
          <div class="address-card-header">
            <strong><%= a.label %></strong>
            <% if (a.is_default) { %><span class="badge badge-primary">Default</span><% } %>
          </div>
          <p><%= a.address %><%= a.city ? ', ' + a.city : '' %><%= a.state ? ', ' + a.state : '' %><%= a.pincode ? ' - ' + a.pincode : '' %></p>
          <p class="text-muted"><%= a.phone %></p>
          <div class="address-actions">
            <button class="btn btn-sm btn-outline" onclick="editAddress(<%= a.id %>, '<%= a.label %>', '<%= a.address.replace(/'/g, "\\'") %>', '<%= a.city %>', '<%= a.state %>', '<%= a.pincode %>', '<%= a.phone %>', <%= a.is_default %>)">Edit</button>
            <form action="/addresses/delete/<%= a.id %>" method="POST" onsubmit="return confirm('Delete this address?')" style="display:inline"><button class="btn btn-sm btn-danger">Delete</button></form>
          </div>
          <form id="edit-form-<%= a.id %>" action="/addresses/edit/<%= a.id %>" method="POST" style="display:none" class="address-form">
            <div class="form-row">
              <div class="form-group"><label>Label</label><input type="text" name="label" value="<%= a.label %>"></div>
              <div class="form-group"><label>Phone *</label><input type="text" name="phone" value="<%= a.phone %>" required></div>
            </div>
            <div class="form-group"><label>Address *</label><textarea name="address" required rows="2"><%= a.address %></textarea></div>
            <div class="form-row">
              <div class="form-group"><label>City</label><input type="text" name="city" value="<%= a.city %>"></div>
              <div class="form-group"><label>State</label><input type="text" name="state" value="<%= a.state %>"></div>
            </div>
            <div class="form-row">
              <div class="form-group"><label>Pincode</label><input type="text" name="pincode" value="<%= a.pincode %>"></div>
              <div class="form-group"><label><input type="checkbox" name="is_default" value="1" <%= a.is_default ? 'checked' : '' %>> Set as default</label></div>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
            <button type="button" class="btn btn-outline" onclick="document.getElementById('edit-form-<%= a.id %>').style.display='none'">Cancel</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<script>
function editAddress(id, label, address, city, state, pincode, phone, isDefault) {
  document.getElementById('edit-form-' + id).style.display = 'block';
}
</script>
<%- include('../partials/footer') %>