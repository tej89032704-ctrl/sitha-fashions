<%- include('../partials/header') %>
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Checkout</h2>
    </div>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="checkout-layout">
      <div class="checkout-form">
        <h3>Delivery Details</h3>
        <form action="/checkout" method="POST" id="checkout-form">
          <% if (addresses.length > 0) { %>
            <div class="form-group">
              <label>Saved Addresses</label>
              <div class="saved-addresses">
                <% addresses.forEach(a => { %>
                  <label class="address-radio">
                    <input type="radio" name="address_id" value="<%= a.id %>" <%= a.is_default ? 'checked' : '' %>>
                    <div>
                      <strong><%= a.label %></strong>
                      <span><%= a.address %><%= a.city ? ', ' + a.city : '' %><%= a.state ? ', ' + a.state : '' %><%= a.pincode ? ' - ' + a.pincode : '' %></span>
                      <small><%= a.phone %></small>
                    </div>
                  </label>
                <% }) %>
              </div>
            </div>
          <% } %>
          <div class="form-group">
            <label><%= addresses.length > 0 ? 'Or enter a new address' : 'Delivery Address' %> *</label>
            <textarea name="address" rows="3"><%= userData.address %></textarea>
          </div>
          <div class="form-group">
            <label>Phone Number *</label>
            <input type="text" name="phone" value="<%= userData.phone %>">
          </div>
          <div class="form-group">
            <label>Coupon Code</label>
            <div class="coupon-input-group">
              <input type="text" name="coupon_code" id="coupon-input" placeholder="Enter coupon code">
              <button type="button" class="btn btn-outline" id="apply-coupon-btn">Apply</button>
            </div>
            <div id="coupon-message" class="coupon-message"></div>
          </div>
          <button type="submit" class="btn btn-primary btn-full galaxy-checkout-btn"><span class="galaxy-btn__content">Place Order</span><div class="galaxy-btn__stars"></div></button>
        </form>
      </div>
      <div class="checkout-summary">
        <h3>Order Summary</h3>
        <div class="summary-items">
          <% items.forEach(item => { %>
            <div class="summary-item">
              <span><%= item.name %> x <%= item.quantity %></span>
              <span>₹<%= (item.price * item.quantity).toLocaleString() %></span>
            </div>
          <% }) %>
        </div>
        <div class="summary-subtotal">
          <span>Subtotal</span>
          <span>₹<%= Number(total).toLocaleString() %></span>
        </div>
        <div class="summary-discount" id="discount-row" style="display:none">
          <span>Discount</span>
          <span>-₹<span id="discount-amount">0</span></span>
        </div>
        <div class="summary-total">
          <strong>Total: ₹<span id="final-total"><%= Number(total).toLocaleString() %></span></strong>
        </div>
          <% if (availableCoupons.length > 0) { %>
            <div class="available-coupons">
              <h4>Available Coupons</h4>
              <% availableCoupons.forEach(c => { %>
                <% var eligible = total >= c.min_order_amount; %>
                <div class="coupon-tag <%= eligible ? 'eligible' : 'ineligible' %>" data-code="<%= c.code %>" data-type="<%= c.discount_type %>" data-value="<%= c.discount_value %>" data-min="<%= c.min_order_amount %>" title="<%= eligible ? 'Click to apply' : 'Min order ₹' + Number(c.min_order_amount).toLocaleString() %>">
                  <strong><%= c.code %></strong>
                  <span><%= c.discount_type === 'percentage' ? c.discount_value + '% off' : '₹' + c.discount_value + ' off' %></span>
                  <% if (c.min_order_amount > 0) { %><small>Min: ₹<%= Number(c.min_order_amount).toLocaleString() %></small><% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
      </div>
    </div>
  </div>
</section>
<script>
const totalAmount = <%= total %>;
const couponInput = document.getElementById('coupon-input');
const discountRow = document.getElementById('discount-row');
const discountAmt = document.getElementById('discount-amount');
const finalTotal = document.getElementById('final-total');
let appliedDiscount = 0;

function applyCoupon(code, type, value, min) {
  if (totalAmount < min) {
    document.getElementById('coupon-message').innerHTML = '<span class="text-error">Minimum order ₹' + Number(min).toLocaleString() + '</span>';
    return;
  }
  let disc = type === 'percentage' ? Math.round(totalAmount * value / 100) : value;
  if (disc > totalAmount) disc = totalAmount;
  appliedDiscount = disc;
  couponInput.value = code;
  discountRow.style.display = 'flex';
  discountAmt.textContent = disc.toLocaleString();
  const net = totalAmount - disc;
  finalTotal.textContent = net.toLocaleString();
  document.getElementById('coupon-message').innerHTML = '<span class="text-success">Coupon applied!</span>';
}

document.getElementById('apply-coupon-btn').addEventListener('click', function() {
  const code = couponInput.value.trim();
  if (!code) return;
  const tag = document.querySelector('.coupon-tag[data-code="' + code.toUpperCase() + '"]');
  if (tag) {
    applyCoupon(tag.dataset.code, tag.dataset.type, parseFloat(tag.dataset.value), parseFloat(tag.dataset.min));
  } else {
    document.getElementById('coupon-message').innerHTML = '<span class="text-error">Invalid coupon</span>';
  }
});

document.querySelectorAll('.coupon-tag.eligible').forEach(tag => {
  tag.addEventListener('click', function() {
    applyCoupon(this.dataset.code, this.dataset.type, parseFloat(this.dataset.value), parseFloat(this.dataset.min));
  });
});
</script>
<%- include('../partials/footer') %>
